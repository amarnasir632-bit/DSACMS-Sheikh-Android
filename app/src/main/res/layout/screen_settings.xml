<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:layoutDirection="rtl">
    <Button android:id="@+id/settings_back" android:layout_width="wrap_content" android:layout_height="52dp" android:text="رجوع" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="حالة الإشعارات" android:textColor="#14253E" android:textSize="25sp" android:textStyle="bold" />
    <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="جارٍ التحقق من حالة الإشعارات…" android:textColor="#24332E" android:textSize="19sp" />
    <TextView android:id="@+id/push_registration_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="جارٍ التحقق من تسجيل الجهاز…" android:textColor="#5A6A7A" android:textSize="16sp" />
    <Button android:id="@+id/enable_notifications" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="20dp" android:text="تفعيل الإشعارات" android:textSize="17sp" />
    <Button android:id="@+id/open_notification_settings" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="10dp" android:text="فتح إعدادات الإشعارات" android:textSize="17sp" />
    <Button android:id="@+id/test_notification" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="10dp" android:text="إرسال إشعار تجريبي" android:textSize="17sp" />
    <Button android:id="@+id/logout_button" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="22dp" android:text="تسجيل الخروج" android:textSize="17sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="قد تؤثر إعدادات النظام أو وضع توفير الطاقة في وصول التنبيهات. لا يحتاج التطبيق إلى تعطيل تحسين البطارية." android:textColor="#65726D" android:textSize="15sp" />
</LinearLayout>
