<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="طلبات التواصل" android:textColor="#123E35" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:text="تطبيق خاص بإدارة طلبات التواصل" android:textColor="#52615C" android:textSize="17sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="38dp" android:text="اسم المستخدم" android:textColor="#24332E" android:textSize="16sp" />
        <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:autofillHints="username" android:hint="اسم المستخدم"
            android:inputType="text" android:padding="14dp" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="كلمة المرور" android:textColor="#24332E" android:textSize="16sp" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:autofillHints="password" android:hint="كلمة المرور"
            android:inputType="textPassword" android:padding="14dp" android:singleLine="true" />
        <Button android:id="@+id/login_button" android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="26dp" android:text="تسجيل الدخول" android:textSize="18sp" />
        <Button android:id="@+id/login_notification_settings" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:text="إعدادات الإشعارات" android:textSize="16sp" />
        <TextView android:id="@+id/login_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center" android:textColor="#8A3D32" android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
