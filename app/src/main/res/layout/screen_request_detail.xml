<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/detail_back" android:layout_width="wrap_content" android:layout_height="52dp" android:text="رجوع للأسئلة" />
        <TextView android:id="@+id/detail_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="السؤال العام" android:textColor="#123E35" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="السائل: —" android:textColor="#24332E" android:textSize="18sp" />
        <TextView android:id="@+id/detail_question" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="السؤال: —" android:textColor="#24332E" android:textSize="18sp" />
        <TextView android:id="@+id/detail_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="التاريخ: —" android:textColor="#52615C" android:textSize="16sp" />
        <TextView android:id="@+id/detail_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="الحالة: —" android:textColor="#52615C" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="الإجابة" android:textColor="#14253E" android:textSize="18sp" android:textStyle="bold" />
        <EditText android:id="@+id/detail_answer" android:layout_width="match_parent" android:layout_height="180dp"
            android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:padding="12dp"
            android:hint="اكتب إجابة الشيخ هنا" />
        <Button android:id="@+id/answer_button" android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="14dp" android:text="نشر الإجابة" android:textSize="17sp" />
        <Button android:id="@+id/archive_question_button" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="10dp" android:text="أرشفة السؤال" android:textSize="16sp" />
        <Button android:id="@+id/delete_question_button" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="8dp" android:text="حذف السؤال" android:textColor="#B3261E" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
