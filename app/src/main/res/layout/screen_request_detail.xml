<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/detail_back" android:layout_width="wrap_content" android:layout_height="52dp" android:text="رجوع إلى الطلبات" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="تفاصيل طلب التواصل" android:textColor="#123E35" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="الاسم: —" android:textColor="#24332E" android:textSize="19sp" />
        <TextView android:id="@+id/detail_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="رقم الهاتف: —" android:textColor="#24332E" android:textSize="19sp" />
        <TextView android:id="@+id/detail_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="السؤال: —" android:textColor="#24332E" android:textSize="18sp" />
        <TextView android:id="@+id/detail_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="التاريخ: —" android:textColor="#52615C" android:textSize="16sp" />
        <TextView android:id="@+id/detail_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="الحالة: —" android:textColor="#52615C" android:textSize="16sp" />
        <Button android:id="@+id/whatsapp_button" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="28dp" android:text="التواصل عبر WhatsApp" android:textSize="17sp" />
        <Button android:id="@+id/ignore_button" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="تجاهل الطلب" android:textSize="17sp" />
        <Button android:id="@+id/viewed_button" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="تحديد كمقروء" android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
