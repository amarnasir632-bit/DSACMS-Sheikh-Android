<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:background="#FAF7F2">

    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
        android:background="#0F2137" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="18dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="الأسئلة العامة" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/settings_button" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="10dp" android:background="@drawable/app_bar_icon_background"
            android:contentDescription="الإعدادات" android:padding="10dp" android:src="@drawable/ic_settings_white" />
        <ImageButton android:id="@+id/refresh_requests" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="10dp" android:background="@drawable/app_bar_icon_background" android:contentDescription="تحديث الأسئلة"
            android:padding="10dp" android:src="@drawable/ic_refresh_white" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="false" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="14dp" android:paddingBottom="12dp">
            <TextView android:id="@+id/filter_new" style="@style/RequestFilterChip" android:text="بانتظار الإجابة" />
            <TextView android:id="@+id/filter_all" style="@style/RequestFilterChip" android:layout_marginStart="8dp" android:text="كل الأسئلة" />
            <TextView android:id="@+id/filter_contacted" style="@style/RequestFilterChip" android:layout_marginStart="8dp" android:text="تمت الإجابة" />
            <TextView android:id="@+id/filter_ignored" style="@style/RequestFilterChip" android:layout_marginStart="8dp" android:text="مؤرشفة" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:orientation="vertical" android:padding="28dp">
            <ImageView android:layout_width="152dp" android:layout_height="90dp" android:contentDescription="شعار الموقع"
                android:scaleType="fitCenter" android:src="@drawable/site_logo" />
            <TextView android:id="@+id/empty_message" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="جارٍ تحميل الأسئلة…" android:textColor="#0F2137"
                android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/empty_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:text="تُحمّل الأسئلة العامة لحساب الشيخ."
                android:textColor="#64748B" android:textSize="15sp" />
        </LinearLayout>
        <ScrollView android:id="@+id/request_list_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:id="@+id/request_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="4dp" android:paddingBottom="20dp" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
